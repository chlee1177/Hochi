+    def undo(self):
+        with self._locked():
+            journal = self._read_journal()
+            if not journal:
+                raise ValueError('되돌릴 정리 기록이 없습니다.')
+            journal['state'] = 'restoring'
+            self._write_journal(journal)
+            self._restore(journal)
+            self.journal.unlink()
+            self.plan = None
+            return len(journal['moves'])
